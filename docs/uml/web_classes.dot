digraph G {
  fontname="Helvetica"
  fontsize=10
  node [fontname="Helvetica", fontsize=10, shape=record];
  edge [fontname="Helvetica", fontsize=10];

  TimeRange [
    shape=none
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" ALIGN="LEFT">
        <TR><TD BGCOLOR="#113322" ALIGN="LEFT"><FONT COLOR="white"><B>TimeRange</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">
          # _preset: str<br/>
          # _start: datetime<br/>
          # _end: datetime
        </TD></TR>
        <TR><TD ALIGN="LEFT">
          + __init__(preset: str = '24h', start: datetime | None = None, end: datetime | None = None)<br/>
          + configure(preset: str = '24h', start: datetime | None = None, end: datetime | None = None): None<br/>
          # _utc(value: datetime): datetime<br/>
          + get_preset(): str<br/>
          + set_preset(value: str): None<br/>
          + get_start(): datetime<br/>
          + set_start(value: datetime): None<br/>
          + get_end(): datetime<br/>
          + set_end(value: datetime): None<br/>
          + to_dict(): dict
        </TD></TR>
      </TABLE>
    >
  ];

  CoachPanel [
    shape=none
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" ALIGN="LEFT">
        <TR><TD BGCOLOR="#113322" ALIGN="LEFT"><FONT COLOR="white"><B>CoachPanel</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">
          # _question: str<br/>
          # _answer: str
        </TD></TR>
        <TR><TD ALIGN="LEFT">
          + __init__(question: str = '', answer: str = '')<br/>
          + configure(question: str = '', answer: str = ''): None<br/>
          # _text(value: str): str<br/>
          + get_question(): str<br/>
          + set_question(value: str): None<br/>
          + get_answer(): str<br/>
          + set_answer(value: str): None<br/>
          + submit_question(question: str): None<br/>
          + set_response(answer: str): None<br/>
          + to_dict(): dict
        </TD></TR>
      </TABLE>
    >
  ];

  EnergySummary [
    shape=none
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" ALIGN="LEFT">
        <TR><TD BGCOLOR="#113322" ALIGN="LEFT"><FONT COLOR="white"><B>EnergySummary</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">
          # _totals: Decimal<br/>
          # _savings: Decimal<br/>
          # _reference: Decimal | None<br/>
          # _score: Decimal | None<br/>
          # _penalties: str
        </TD></TR>
        <TR><TD ALIGN="LEFT">
          + __init__(totals = 0, savings = 0, reference = None, score = None, penalties = '')<br/>
          + configure(totals = 0, savings = 0, reference = None, score = None, penalties = ''): None<br/>
          # _number(value, label: str, minimum: Decimal | None = None, maximum: Decimal | None = None): Decimal<br/>
          + get_totals(): Decimal<br/>
          + set_totals(value): None<br/>
          + get_savings(): Decimal<br/>
          + set_savings(value): None<br/>
          + get_reference(): Decimal | None<br/>
          + set_reference(value): None<br/>
          + get_score(): Decimal | None<br/>
          + set_score(value): None<br/>
          + get_penalties(): str<br/>
          + set_penalties(value): None<br/>
          + to_dict(): dict
        </TD></TR>
      </TABLE>
    >
  ];
}