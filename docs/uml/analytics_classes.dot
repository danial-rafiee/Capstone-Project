digraph AnalyticsUML {
  graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.9", ranksep="1.0",
    splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=20,
    labelloc=t, label="Subsystem B class diagram\nImplemented classes in smart_energy.analytics"];
  node [shape=plain, fontname="Arial", fontsize=13];
  edge [color="#52656D", fontname="Arial", fontsize=12, arrowhead=vee,
    arrowsize=0.75, penwidth=1.2, labeldistance=2.0, labelangle=25];
  Building [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>Building</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _building_id: int<BR ALIGN="LEFT"/># _name: str<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(building_id: int, name: str)<BR ALIGN="LEFT"/>+ get_building_id(): int<BR ALIGN="LEFT"/>+ set_building_id(building_id: int): None<BR ALIGN="LEFT"/>+ get_name(): str<BR ALIGN="LEFT"/>+ set_name(name: str): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Meter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>Meter</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _meter_id: int<BR ALIGN="LEFT"/># _building: Building<BR ALIGN="LEFT"/># _name: str<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(meter_id: int, building: Building, name: str)<BR ALIGN="LEFT"/>+ get_meter_id(): int<BR ALIGN="LEFT"/>+ set_meter_id(meter_id: int): None<BR ALIGN="LEFT"/>+ get_building(): Building<BR ALIGN="LEFT"/>+ set_building(building: Building): None<BR ALIGN="LEFT"/>+ get_building_id(): int<BR ALIGN="LEFT"/>+ get_name(): str<BR ALIGN="LEFT"/>+ set_name(name: str): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Reading [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>Reading</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _meter: Meter<BR ALIGN="LEFT"/># _start: datetime<BR ALIGN="LEFT"/># _end: datetime<BR ALIGN="LEFT"/># _energy_kwh: Decimal<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(meter: Meter, start: datetime, end: datetime, energy_kwh: Decimal)<BR ALIGN="LEFT"/>+ get_meter(): Meter<BR ALIGN="LEFT"/>+ set_meter(meter: Meter): None<BR ALIGN="LEFT"/>+ get_meter_id(): int<BR ALIGN="LEFT"/>+ get_interval(): tuple[datetime, datetime]<BR ALIGN="LEFT"/>+ set_interval(start: datetime, end: datetime): None<BR ALIGN="LEFT"/>+ get_energy_kwh(): Decimal<BR ALIGN="LEFT"/>+ set_energy_kwh(energy_kwh: Decimal): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EnergySettings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>EnergySettings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _building: Building<BR ALIGN="LEFT"/># _tariff: Decimal<BR ALIGN="LEFT"/># _carbon_factor: Decimal<BR ALIGN="LEFT"/># _off_hours_share: Decimal<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(building: Building, tariff: Decimal, carbon_factor: Decimal, off_hours_share: Decimal)<BR ALIGN="LEFT"/>+ configure(tariff: Decimal, carbon_factor: Decimal, off_hours_share: Decimal): None<BR ALIGN="LEFT"/>+ get_building(): Building<BR ALIGN="LEFT"/>+ set_building(building: Building): None<BR ALIGN="LEFT"/>+ get_building_id(): int<BR ALIGN="LEFT"/>+ get_tariff(): Decimal<BR ALIGN="LEFT"/>+ set_tariff(tariff: Decimal): None<BR ALIGN="LEFT"/>+ get_carbon_factor(): Decimal<BR ALIGN="LEFT"/>+ set_carbon_factor(carbon_factor: Decimal): None<BR ALIGN="LEFT"/>+ get_off_hours_share(): Decimal<BR ALIGN="LEFT"/>+ set_off_hours_share(off_hours_share: Decimal): None<BR ALIGN="LEFT"/># _validate_factor(value: Decimal, label: str): None<BR ALIGN="LEFT"/># _validate_share(off_hours_share: Decimal): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AnalyticsService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>AnalyticsService</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _readings: list[Reading]<BR ALIGN="LEFT"/># _settings: EnergySettings<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(settings: EnergySettings, readings = None)<BR ALIGN="LEFT"/>+ get_settings(): EnergySettings<BR ALIGN="LEFT"/>+ set_settings(settings: EnergySettings): None<BR ALIGN="LEFT"/>+ get_readings(): list[Reading]<BR ALIGN="LEFT"/>+ set_readings(readings: list[Reading]): None<BR ALIGN="LEFT"/>+ add_reading(reading: Reading): None<BR ALIGN="LEFT"/>+ totals(): dict<BR ALIGN="LEFT"/># _validate_readings(readings: list[Reading], settings: EnergySettings): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  { rank=same; Building; Meter; Reading; }
  { rank=same; EnergySettings; AnalyticsService; }
  Meter -> Building [label="_building", taillabel="0..*", headlabel="1"];
  Reading -> Meter [label="_meter", taillabel="0..*", headlabel="1"];
  EnergySettings -> Building [label="_building", taillabel="0..*", headlabel="1"];
  AnalyticsService -> EnergySettings [label="_settings", taillabel="0..*", headlabel="1"];
  AnalyticsService -> Reading [label="_readings", taillabel="0..*", headlabel="0..*"];
}
