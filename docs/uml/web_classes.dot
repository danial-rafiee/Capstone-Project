digraph WebUML {
  graph [rankdir=BT, bgcolor="white", pad="0.4", nodesep="0.9", ranksep="1.0",
    splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=20,
    labelloc=t, label="Subsystem A class diagram\nImplemented classes in smart_energy.web"];
  node [shape=plain, fontname="Arial", fontsize=13];
  edge [color="#087F79", fontname="Arial", fontsize=12, arrowhead=vee,
    arrowsize=0.75, penwidth=1.2, labeldistance=2.0, labelangle=25];
  TimeRange [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>TimeRange</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _preset: str<BR ALIGN="LEFT"/># _start: datetime<BR ALIGN="LEFT"/># _end: datetime<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(preset: str = &#x27;24h&#x27;, start: datetime | None = None, end: datetime | None = None)<BR ALIGN="LEFT"/>+ configure(preset: str = &#x27;24h&#x27;, start: datetime | None = None, end: datetime | None = None): None<BR ALIGN="LEFT"/># _utc(value: datetime): datetime<BR ALIGN="LEFT"/>+ get_preset(): str<BR ALIGN="LEFT"/>+ set_preset(value: str): None<BR ALIGN="LEFT"/>+ get_start(): datetime<BR ALIGN="LEFT"/>+ set_start(value: datetime): None<BR ALIGN="LEFT"/>+ get_end(): datetime<BR ALIGN="LEFT"/>+ set_end(value: datetime): None<BR ALIGN="LEFT"/>+ to_dict(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EnergySummary [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>EnergySummary</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _totals: dict<BR ALIGN="LEFT"/># _savings: dict<BR ALIGN="LEFT"/># _reference: dict<BR ALIGN="LEFT"/># _score: float<BR ALIGN="LEFT"/># _penalties: list<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(totals = 0, savings = 0, reference = None, score = None, penalties: str = &#x27;&#x27;)<BR ALIGN="LEFT"/>+ configure(totals = 0, savings = 0, reference = None, score = None, penalties: str = &#x27;&#x27;): None<BR ALIGN="LEFT"/># _number(value, label: str, minimum: Decimal | None = None, maximum: Decimal | None = None): Decimal<BR ALIGN="LEFT"/>+ get_totals(): Decimal<BR ALIGN="LEFT"/>+ set_totals(value): None<BR ALIGN="LEFT"/>+ get_savings(): Decimal<BR ALIGN="LEFT"/>+ set_savings(value): None<BR ALIGN="LEFT"/>+ get_reference(): Decimal | None<BR ALIGN="LEFT"/>+ set_reference(value): None<BR ALIGN="LEFT"/>+ get_score(): Decimal | None<BR ALIGN="LEFT"/>+ set_score(value): None<BR ALIGN="LEFT"/>+ get_penalties(): str<BR ALIGN="LEFT"/>+ set_penalties(value: str): None<BR ALIGN="LEFT"/>+ to_dict(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CoachPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#087F79"><TR><TD BGCOLOR="#102E31"><FONT COLOR="white" POINT-SIZE="16"><B>CoachPanel</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F0F6F5"># _question: str<BR ALIGN="LEFT"/># _answer: str<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ __init__(question: str = &#x27;&#x27;, answer: str = &#x27;&#x27;)<BR ALIGN="LEFT"/>+ configure(question: str = &#x27;&#x27;, answer: str = &#x27;&#x27;): None<BR ALIGN="LEFT"/># _text(value: str): str<BR ALIGN="LEFT"/>+ get_question(): str<BR ALIGN="LEFT"/>+ set_question(value: str): None<BR ALIGN="LEFT"/>+ get_answer(): str<BR ALIGN="LEFT"/>+ set_answer(value: str): None<BR ALIGN="LEFT"/>+ submit_question(question: str): None<BR ALIGN="LEFT"/>+ set_response(answer: str): None<BR ALIGN="LEFT"/>+ to_dict(): dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
